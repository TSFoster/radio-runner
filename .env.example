# Radio Settings
RADIO_IP=192.168.0.123
RADIO_PIN=1234
RADIO_PORT=80

# Calendar Subscription URL (webcal:// or http:// or https://)
CALENDAR_URL=https://calendar.google.com/calendar/ical/your_calendar_id/public/basic.ics

# Optional: Keyword filter for events (leave empty to schedule all calendar events)
CALENDAR_KEYWORD=

# Sync Frequency & Lookahead Window
SYNC_INTERVAL_MINUTES=15
LOOKAHEAD_HOURS=24

# Default Radio Settings on Alarm Trigger
DEFAULT_SOURCE=DAB
DEFAULT_VOLUME=12

# Server Port
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
